# Copia este archivo a local.properties (ya está en .gitignore).
# No subas tokens, passwords seed ni google-services.json al repositorio.

sdk.dir=/path/to/Android/sdk

# MOCK (default) o REMOTE
vaiinillaDataSource=MOCK

# Backend Railway de desarrollo (Saúl)
vaiinillaApiBaseUrl=https://vaiinillaback-development-3f6c.up.railway.app/api/v1/

# REMOTE debug: passwords seed Firebase (solo local.properties, nunca en git).
# Tras rotar en Firebase Console / Identity Toolkit, pégalos aquí.
# Ver docs/FIREBASE_SEED_AUTH.md
vaiinillaSeedPasswordCliente=
vaiinillaSeedPasswordCajero=
vaiinillaSeedPasswordCocina=
vaiinillaSeedPasswordMesero=

# JWT opcionales (MOCK o override manual); no commitear valores.
vaiinillaAccessToken=
vaiinillaAccessTokenCliente=
vaiinillaAccessTokenCajero=
vaiinillaAccessTokenCocina=
vaiinillaAccessTokenMesero=
