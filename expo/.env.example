# Copy to .env and restart Expo (npm run start) after changes.
# MOCK works offline with fixtures; REMOTE needs Firebase + API.

# Data source: MOCK (default) | REMOTE
EXPO_PUBLIC_VAIINILLA_DATA_SOURCE=

# Railway API base (trailing slash optional)
EXPO_PUBLIC_API_BASE_URL=

# Firebase — required for REMOTE login (leave empty for MOCK-only demos)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
